# Discord bot token from the Developer Portal (Bot tab).
RED_TICKET_BOT_TOKEN=

# Channel ID for the public "Red Tickets" channel (right-click channel -> Copy Channel ID).
RED_TICKET_PUBLIC_CHANNEL_ID=

# Channel ID for the private "Red Ticket Log" channel.
RED_TICKET_LOG_CHANNEL_ID=

# Optional: set to a guild ID during development so slash commands
# sync instantly instead of waiting up to an hour for a global sync.
RED_TICKET_GUILD_ID=
